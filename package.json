{
  "name": "paperless-upload",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A focused Chrome extension for sending PDFs to Paperless-ngx.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run format && npm run build && npm test && npm run test:e2e",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
