{
  "manifest_version": 3,
  "name": "Paperless Upload",
  "default_locale": "en",
  "version": "0.5.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "offscreen",
    "webRequest",
    "webNavigation"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*", "file:///*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "mime_types_handler": {
    "application/pdf": { "handler_url": "capture.html", "can_embed": true }
  },
  "action": {
    "default_title": "__MSG_sendPdf__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; frame-src 'none'; connect-src 'self' https: http: file:; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
